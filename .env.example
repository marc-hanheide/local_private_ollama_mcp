# Copy to .env in the server's working directory. Variables already set in the environment win.
# DOC_ROOT and OUTPUT_DIR default to ~/Downloads (or ~/Download).
# DOC_ROOT=$HOME/private-docs
# OUTPUT_DIR=$HOME/private-docs/notes
# CACHE_DIR=$HOME/.local-llm-mcp/cache
# AUDIT_LOG=$HOME/.local-llm-mcp/audit.jsonl

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
# Only if your Ollama needs a bearer token:
# OLLAMA_API_KEY=
NUM_CTX=8192
